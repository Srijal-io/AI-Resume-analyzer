{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noImplicitAny": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./*"],
      "@resurox/schemas": ["../../packages/schemas/src/index.ts", "../../packages/schemas/src/index"],
      "@resurox/schemas/*": ["../../packages/schemas/src/*"],
      "@resurox/matching": ["../../packages/matching/src/index.ts", "../../packages/matching/src/index"],
      "@resurox/matching/*": ["../../packages/matching/src/*"],
      "@resurox/ai": ["../../packages/ai/src/index.ts", "../../packages/ai/src/index"],
      "@resurox/ai/*": ["../../packages/ai/src/*"],
      "@resurox/db": ["../../packages/db/src/index.ts", "../../packages/db/src/index"],
      "@resurox/db/*": ["../../packages/db/src/*"],
      "@resurox/resume": ["../../packages/resume/src/index.ts", "../../packages/resume/src/index"],
      "@resurox/resume/*": ["../../packages/resume/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../../apps/extension",
    "../extension"
  ]
}
